# Gabarit pour l'environnement de PRODUCTION du backend.
#
# Ne pas commiter le .env réel : sur la plateforme de déploiement
# (Docker/serveur/PaaS), définir ces variables comme secrets
# d'environnement plutôt que de déployer un fichier .env.
#
# Valeurs à changer obligatoirement par rapport au dev :

APP_NAME=Portovero API
ENVIRONMENT=production
DEBUG=false

# Base de données de production (jamais celle de dev).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/portovero

# Clé unique et secrète, différente de celle du dev.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Domaines réels du store et de l'admin en production (utilisés pour CORS).
FRONTEND_URL=https://www.portovero.com
ADMIN_URL=https://admin.portovero.com

# Pour créer/mettre à jour le compte admin en prod (script one-shot) :
# ADMIN_EMAIL=...
# ADMIN_PASSWORD=...
