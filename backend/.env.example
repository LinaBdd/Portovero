# Copier ce fichier vers .env (dev) et renseigner de vraies valeurs.
# .env n'est jamais commité (voir .gitignore) — chaque environnement
# (dev/staging/prod) a le sien. Pour la prod, voir .env.production.example.
#
# Toutes ces variables sont lues par app/core/config.py (Settings).

# --- Application ---
APP_NAME=Portovero API
ENVIRONMENT=development
DEBUG=true

# --- Base de données ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portovero

# --- Sécurité JWT ---
# Générer une vraie valeur : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Origines autorisées (CORS) ---
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3000

# --- Utilisées uniquement par app/scripts/create_admin.py ---
# (pas lues par Settings ; à exporter seulement pour lancer ce script)
ADMIN_EMAIL=admin@portovero.com
ADMIN_PASSWORD=change_this_password
