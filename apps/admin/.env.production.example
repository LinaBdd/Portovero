# Gabarit pour l'environnement de PRODUCTION de l'admin.
#
# Sur Vercel/Netlify/etc., définir NEXT_PUBLIC_API_URL dans les paramètres
# d'environnement de production du projet plutôt que de déployer un fichier
# .env. Si le déploiement se fait par conteneur/serveur, copier ce fichier
# vers .env.production (non commité).
#
# NEXT_PUBLIC_* est intégré au bundle au build : reconstruire après tout
# changement de valeur.

NEXT_PUBLIC_API_URL=https://api.portovero.com
