# Copier ce fichier vers .env.local (dev) — jamais commité.
# Next.js charge automatiquement .env.local, .env.development, .env.production
# selon le mode ; voir .env.production.example pour la prod.
#
# Lu une seule fois par src/lib/api/config.ts (API_URL) : ne pas relire
# process.env.NEXT_PUBLIC_API_URL ailleurs dans le code.

# URL publique de l'API backend, jamais de slash final.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
